# =============================================================================
#  FloodWatch – variables de déploiement. Copier en .env et CHANGER les secrets.
#  Générer des secrets :  openssl rand -base64 36
# =============================================================================
# Nom DNS (ou IP) public de la VM : utilisé pour le certificat TLS et Nginx
SERVER_NAME=floodwatch.example.tn

DB_NAME=floodwatch
DB_USER=floodwatch
DB_PASSWORD=change-me-db

MQTT_API_USERNAME=floodwatch-api
MQTT_API_PASSWORD=change-me-mqtt-api
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=change-me-mqtt-gateway

# 32 caractères minimum
JWT_SECRET=change-me-change-me-change-me-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me-operator

# Web Push : laisser vide pour générer les clés au premier démarrage (stockées en base)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:floodwatch@supcom.tn
