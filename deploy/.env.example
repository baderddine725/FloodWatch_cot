# =============================================================================
#  FloodWatch – variables de déploiement. Copier en .env et CHANGER les secrets.
#  Générer des secrets :  openssl rand -base64 36
# =============================================================================
# Nom DNS (ou IP) public de la VM : utilisé pour le certificat TLS et Nginx
SERVER_NAME=floodwatch.example.tn

DB_NAME=floodwatch
DB_USER=floodwatch
DB_PASSWORD=change-me-db

MQTT_API_USERNAME=floodwatch-api
MQTT_API_PASSWORD=change-me-mqtt-api
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=change-me-mqtt-gateway

# 32 caractères minimum
JWT_SECRET=change-me-change-me-change-me-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me-operator

# Web Push : laisser vide pour générer les clés au premier démarrage (stockées en base)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:floodwatch@supcom.tn

# -----------------------------------------------------------------------------
#  Partie Back-end & IoT (Ksontini Amine) – profils « iot », « test », « tools »
#  docker compose --profile iot up -d --build
# -----------------------------------------------------------------------------
# Compte observateur (lecture seule) du broker Cloud : vide = pas de compte
MQTT_OBSERVER_PASSWORD=change-me-observer
# Broker local de la passerelle : Node-RED (gateway), diagnostic (diag), stations
LOCAL_GATEWAY_PASSWORD=change-me-gateway-local
LOCAL_DIAG_PASSWORD=change-me-diag
STATION_PASSWORD=change-me-station
STATION_CODES=underpass-01 wadi-01
LOCAL_MQTT_PORT=1883
# Passerelle Node-RED (éditeur : utilisateur admin, 8 caractères minimum)
GATEWAY_ID=gw-ariana-01
NODE_RED_ADMIN_PASSWORD=change-me-nodered
NODE_RED_PORT=1880
MUTE_AFTER_SEC=60
SAFETY_PCT=85
# Simulateur (scénarios : storm, flash, drizzle, calm, fault)
SIM_SCENARIO=storm
SIM_SPEED=3
SIM_OFFLINE_AFTER=0
