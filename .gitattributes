#  Rôle      : fins de ligne LF pour tout ce qui est exécuté ou lu dans les conteneurs
#              Linux (sinon « bad interpreter » ou ACL Mosquitto illisible sous Windows).
# =============================================================================
*.sh        text eol=lf
mvnw        text eol=lf
*.conf      text eol=lf
*.acl       text eol=lf
**/mosquitto/acl  text eol=lf
Dockerfile  text eol=lf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
