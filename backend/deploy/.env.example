# =============================================================================
#  FloodWatch – variables de déploiement. Copier en .env et CHANGER les secrets.
#  Générer des secrets :  openssl rand -base64 36
# =============================================================================
# ---------------------------------------------------------------------------
#  Domaine local FloodWatch. Quatre noms de service en découlent :
#    www.<domaine>    front-office (espace citoyen)   -> WildFly, www-host
#    admin.<domaine>  back-office (espace pilotage)   -> WildFly, admin-host
#    api.<domaine>    API REST, WebSocket, Thing Descriptions -> api-host
#    iam.<domaine>    authentification (/api/auth/**) -> api-host, filtre iam-scope
#    mqtt.<domaine>   broker MQTT (TLS 1.3, port 8883)
#  Changer BASE_DOMAIN impose un « docker compose build » : les alias des hôtes
#  virtuels sont écrits dans standalone.xml à la construction de l'image.
#  N.B. « .local » est réservé au mDNS (RFC 6762) : sous Windows et macOS, le
#  résolveur du système peut court-circuiter le serveur DNS. Sur un poste de
#  travail, préférez scripts/dns-hosts.ps1 (Windows) ou dns-hosts.sh (Linux).
# ---------------------------------------------------------------------------
BASE_DOMAIN=floodwatch.local
# Adresse sur laquelle le serveur DNS fait pointer tous les noms du domaine :
# 127.0.0.1 en poste de travail, adresse de la VM en déploiement.
PUBLIC_IP=127.0.0.1
# Port d'écoute du serveur DNS. Sous Ubuntu, systemd-resolved occupe déjà le 53 :
# voir docs/deployment.md (DNSStubListener=no) ou choisir un autre port.
DNS_PORT=53

DB_NAME=floodwatch
DB_USER=floodwatch
DB_PASSWORD=change-me-db

MQTT_API_USERNAME=floodwatch-api
MQTT_API_PASSWORD=change-me-mqtt-api
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=change-me-mqtt-gateway

# 32 caractères minimum
JWT_SECRET=change-me-change-me-change-me-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me-operator

# Web Push : laisser vide pour générer les clés au premier démarrage (stockées en base)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:floodwatch@supcom.tn

# -----------------------------------------------------------------------------
#  Partie Back-end & IoT (Ksontini Amine) – profils « iot », « test », « tools »
#  docker compose --profile iot up -d --build
# -----------------------------------------------------------------------------
# Compte observateur (lecture seule) du broker Cloud : vide = pas de compte
MQTT_OBSERVER_PASSWORD=change-me-observer
# Broker local de la passerelle : Node-RED (gateway), diagnostic (diag), stations
LOCAL_GATEWAY_PASSWORD=change-me-gateway-local
LOCAL_DIAG_PASSWORD=change-me-diag
STATION_PASSWORD=change-me-station
STATION_CODES="upstream-01 wadi-01 underpass-01"
LOCAL_MQTT_PORT=1883
# Passerelle Node-RED (éditeur : utilisateur admin, 8 caractères minimum)
GATEWAY_ID=gw-ariana-01
# Compte Cloud dédié de cette passerelle (utilisateur = GATEWAY_ID, limité à STATION_CODES)
GATEWAY_CLOUD_PASSWORD=change-me-gateway-cloud
# Passerelles Raspberry Pi supplémentaires : "gw-id|mot-de-passe|station station;gw-id2|..."
GATEWAY_ACCOUNTS_EXTRA=
NODE_RED_ADMIN_PASSWORD=change-me-nodered
NODE_RED_PORT=1880
MUTE_AFTER_SEC=60
SAFETY_PCT=85
# Prévision du Cloud : entrée météo none (persistance de la pluie mesurée) ou open-meteo.
# Laisser none avec le simulateur (la pluie réelle de la zone n'est pas la pluie simulée).
FORECAST_WEATHER_PROVIDER=none
# Même choix pour la passerelle (pré-alertes de propagation du fog).
GATEWAY_WEATHER_PROVIDER=none
# Simulateur (scénarios : season, storm, flash, drizzle, calm, fault).
# season : orages de zone répétés (15 min simulées chacun) -> la passerelle calibre les sites en continu ;
# storm : un seul orage au démarrage.
SIM_SCENARIO=season
# Défauts du capteur de niveau simulé : none (sain) ou random (mousse, obstacle, capteur figé, dérive...)
SIM_FAULTS=none
# Accélération du temps simulé. Garder 1 avec la passerelle : les temps de parcours (stations.json),
# la calibration du fog et les prévisions du Cloud sont en temps physique (horloge réelle).
SIM_SPEED=1
SIM_OFFLINE_AFTER=0

# ----------------------------------------------------------------- VM publique (scripts/deploy-cloud.sh)
# Profils démarrés par « docker compose up » (iot : passerelle + stations simulées ; ml : cycle MLOps).
#COMPOSE_PROFILES=iot,ml
# Courriel du compte Let's Encrypt ; certificat web (dans certs/) : server.crt (AC privée) par défaut,
# web.crt une fois le certificat Let's Encrypt obtenu (scripts/renew-web-cert.sh).
LETSENCRYPT_EMAIL=
WEB_CERT=server.crt
WEB_KEY=server.key
# Cycle MLOps (profil ml) : cadence, réapprentissage, profondeur d'historique, paires avant décision.
ML_CYCLE_MINUTES=30
ML_RETRAIN_HOURS=6
ML_TRAIN_DAYS=14
ML_MIN_PAIRS=100
MLFLOW_PORT=5000
