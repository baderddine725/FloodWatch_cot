# =============================================================================
#  Module   : Cloud of Things – FloodWatch (Sup'Com 2026-2027)
#  Fichier  : backend/deploy/nginx/templates/default.conf.template
#  Équipe   : FloodWatch – Guesmi Baderddine, Ksontini Amine, Kamoun Ahmed
#  Version  : 2.2 – 2026-11-23
#  Rôle     : TERMINAISON TLS et reverse proxy, rien de plus.
#
#  Depuis la version 2.0, Nginx ne sert plus aucun fichier du front-end : les deux
#  interfaces sont servies par WildFly (hôtes virtuels Undertow www-host et
#  admin-host, voir middleware/wildfly/add-host.cli). Nginx déchiffre le TLS et
#  transmet la requête en conservant l'en-tête Host, qui est la clé du routage
#  côté Undertow :
#
#    www.${BASE_DOMAIN}   /  ${BASE_DOMAIN}   -> www-host    (front-office citoyen)
#    admin.${BASE_DOMAIN}                     -> admin-host  (back-office pilotage)
#    api.${BASE_DOMAIN}                       -> api-host    (REST, WebSocket, TD)
#    iam.${BASE_DOMAIN}                       -> api-host    (routes /api/auth/** seules)
#
#  Les en-têtes de sécurité (HSTS, nosniff, Referrer-Policy), le cache et les
#  en-têtes CORS sont posés par Undertow : ne pas les dupliquer ici.
#  ${BASE_DOMAIN}, ${WEB_CERT} et ${WEB_KEY} sont substitués au démarrage du conteneur
#  (image officielle nginx). Certificat web : celui de l'AC privée (server.crt) par défaut ; sur
#  une VM publique, un certificat Let's Encrypt (web.crt, scripts/renew-web-cert.sh), reconnu par
#  les navigateurs et les smartphones. Le broker MQTT garde l'AC privée de ses passerelles.
# =============================================================================
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Résolution dynamique du conteneur « api ». Docker lui attribue une nouvelle adresse à chaque
# reconstruction ; sans « resolve », Nginx garderait l'adresse lue à son propre démarrage et
# répondrait 502 après chaque mise à jour du middleware (scripts/update.sh), jusqu'à ce qu'on
# le redémarre. 127.0.0.11 est le DNS interne de Docker ; « resolve » exige une zone partagée
# (Nginx >= 1.27.3).
resolver 127.0.0.11 valid=10s ipv6=off;

upstream wildfly {
    zone wildfly 64k;
    server api:8080 resolve;
    keepalive 16;
}

# ----------------------------------------------------------------- HTTP : ACME + redirection
server {
    listen 80;
    server_name ${BASE_DOMAIN} www.${BASE_DOMAIN} admin.${BASE_DOMAIN} api.${BASE_DOMAIN} iam.${BASE_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# ----------------------------------------------------------------- HTTPS : les quatre noms
server {
    listen 443 ssl;
    http2 on;
    server_name ${BASE_DOMAIN} www.${BASE_DOMAIN} admin.${BASE_DOMAIN} api.${BASE_DOMAIN} iam.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/${WEB_CERT};
    ssl_certificate_key /etc/nginx/certs/${WEB_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 1m;
    gzip on;
    gzip_proxied any;
    # text/html est toujours compressé par Nginx : le répéter provoque un avertissement
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # Flux temps réel : connexion longue, mise à niveau WebSocket
    location /ws/ {
        proxy_pass http://wildfly;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Tout le reste (front-ends statiques, REST, IAM) : Undertow route sur le Host
    location / {
        proxy_pass http://wildfly;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        # Indispensable : Undertow (proxy-address-forwarding) en déduit le schéma et le
        # port d'origine, dont dépendent les prédicats « equals(%p,443) » des filtres.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 60s;
    }
}
