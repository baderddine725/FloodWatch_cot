            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 412\", () => pm.response.to.have.status(412));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({key: \"If-Match\", value: \"\\\"obsolete\\\"\"});"
                ]
              }
            }
          ]
        },
