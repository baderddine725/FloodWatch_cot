{
  "info": {
    "name": "FloodWatch API",
    "description": "Tests REST de l'API FloodWatch (Jakarta EE 11). Exécution : newman run FloodWatch.postman_collection.json -e local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Public",
      "item": [
        {
          "name": "Santé",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"base et broker\", () => { const j = pm.response.json(); pm.expect(j.database).to.be.true; pm.expect(j.mqtt).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Stations (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stations"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"au moins une station\", () => pm.expect(s.length).to.be.above(0));",
                  "pm.test(\"pas de donnée sensible\", () => pm.expect(s[0]).to.not.have.property(\"password\"));",
                  "pm.collectionVariables.set(\"station\", s[0].code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Station par code + ETag",
